{
  "name": "mixflow-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prototype personnel de candidature : flux, stockage et traçabilité des mélanges de laboratoire. Données fictives, projet non affilié à Michelin.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
